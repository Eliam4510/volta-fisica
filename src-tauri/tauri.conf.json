{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Volta",
  "version": "0.15.0",
  "identifier": "io.github.eliam4510.volta",
  "build": {
    "frontendDist": "../sistema"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Volta",
        "url": "prototipos/inicio.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Eliam Mojardin Ibarra",
    "category": "Education",
    "shortDescription": "Simulador de física",
    "longDescription": "Volta es un simulador de física para Windows, organizado en módulos y orientado al temario de Física MEXT.",
    "copyright": "© 2026 Eliam Mojardin Ibarra. Licencia MIT.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBREFDNzQzNjlDMDgwNEYKUldSUGdNQnBROGZhQ3B3bFk3d1Ztb2ZaK3V6TWdiRW1ucW5tWU1UVnZXTUgxWjFhcXNpWDk0c3QK",
      "endpoints": [
        "https://github.com/Eliam4510/volta-fisica/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
